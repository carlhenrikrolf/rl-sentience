{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": ".env", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "deny": [
        "Read(~/.ssh/**)",
        "Read(./.env)",
        "Edit(./AGENTS.md)"
    ],
    "ask": [
        "./docs/**"
    ]
  }
}